{
  "name": "nodejs-expressjs-mongodb-base-project",
  "private": true,
  "version": "1.0.0",
  "author": "vu9huy",
  "type": "module",
  "description": "",
  "scripts": {
    "lint": "eslint src --ext js --report-unused-disable-directives --max-warnings 20",
    "clean": "rm -rf build && mkdir build",
    "build-babel": "babel ./src -d ./build/src --copy-files",
    "create-courts-file": "node ./src/api/utils/createCourtsDataFile.js",
    "build": "npm run clean && npm run build-babel",
    "production": "npm run build && node ./build/src/index.js",
    "start": "node ./build/src/index.js",
    "dev": "nodemon --exec babel-node ./src/index.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.9",
    "@google-analytics/data": "^4.10.0",
    "async": "^3.2.5",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-handlebars": "^7.1.3",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "http-status": "^1.7.4",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongodb": "^6.7.0",
    "mongoose": "^8.4.3",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "nodemailer-express-handlebars": "^6.1.2",
    "redis": "^4.6.15",
    "util": "^0.12.5",
    "validator": "^13.12.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.10",
    "@babel/core": "^7.26.9",
    "@babel/eslint-parser": "^7.22.10",
    "@babel/node": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@dicebear/collection": "^9.2.4",
    "@dicebear/core": "^9.2.4",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.47.0",
    "nodemon": "^3.0.1"
  },
  "resolutions": {
    "strip-ansi": "6.0.1"
  }
}
